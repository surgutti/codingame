{
  "source": "brain.cpp",
  "cxx": "g++",
  "cxxflags": ["-std=c++20", "-O2", "-DLOCAL", "-DPSYLEAGUE"],
  "referee": "referee.jar",
  "build_dir": "arena/smoke/build",
  "variants": [
    {"name": "baseline", "defines": {"BOT_TIMEOUT_SCALE_PCT": 100}},
